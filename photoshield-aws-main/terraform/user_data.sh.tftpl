#!/bin/bash
# Bootstraps a web instance: downloads the app from S3, installs the RDS TLS CA
# bundle and a `dbshell` helper, then runs the app under systemd as an
# unprivileged user.
# App version: ${app_hash}
set -euxo pipefail

dnf install -y python3.11 python3.11-pip mariadb105

mkdir -p /opt/app
aws s3 cp --recursive --region ${region} "s3://${s3_bucket}/app/" /opt/app/
curl -fsSL -o /opt/app/rds-ca.pem https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem

python3.11 -m venv /opt/app/venv
/opt/app/venv/bin/pip install --quiet -r /opt/app/requirements.txt

id appuser >/dev/null 2>&1 || useradd --system --home-dir /opt/app --shell /sbin/nologin appuser
chown -R appuser:appuser /opt/app

cat > /etc/systemd/system/photoshield.service <<'EOF'
[Unit]
Description=PhotoShield web app
After=network-online.target
Wants=network-online.target

[Service]
User=appuser
WorkingDirectory=/opt/app
Environment=AWS_REGION=${region}
Environment=DB_HOST=${db_host}
Environment=DB_NAME=${db_name}
Environment=DB_SECRET_ARN=${db_secret_arn}
Environment=S3_BUCKET=${s3_bucket}
ExecStart=/opt/app/venv/bin/gunicorn --workers 2 --timeout 60 --bind 0.0.0.0:${app_port} --access-logfile - app:app
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
EOF

# Demo helper: `dbshell` opens a MySQL shell on RDS over verified TLS,
# using credentials fetched from Secrets Manager (nothing stored on disk).
cat > /usr/local/bin/dbshell <<'EOF'
#!/bin/bash
set -euo pipefail
SECRET=$(aws secretsmanager get-secret-value --region ${region} --secret-id '${db_secret_arn}' --query SecretString --output text)
DBUSER=$(printf '%s' "$SECRET" | python3 -c 'import json,sys; print(json.load(sys.stdin)["username"])')
export MYSQL_PWD=$(printf '%s' "$SECRET" | python3 -c 'import json,sys; print(json.load(sys.stdin)["password"])')
exec mariadb --host=${db_host} --user="$DBUSER" --database=${db_name} \
  --ssl-ca=/opt/app/rds-ca.pem --ssl-verify-server-cert "$@"
EOF
chmod 755 /usr/local/bin/dbshell

systemctl daemon-reload
systemctl enable --now photoshield
